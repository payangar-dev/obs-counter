# =============================================================================
# .gitignore pour plugin OBS C++
# =============================================================================

# Dossiers de build
build/
cmake-build-*/
out/

# Fichiers compilés
*.o
*.so
*.dll
*.lib
*.exp
*.pdb

# Fichiers générés par CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Fichiers Qt générés (MOC, UIC, RCC)
*_autogen/
moc_*.cpp
ui_*.h
qrc_*.cpp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers système
.DS_Store
Thumbs.db
